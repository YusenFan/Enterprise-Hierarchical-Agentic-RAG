# OpenAI-compatible endpoint used by every "api:" backend (embedding, abstraction, QA).
# Copy this file to ".env" (git-ignored) and fill in your key. Shell exports take precedence.
# Leave OPENAI_BASE_URL empty (or delete the line) to use the official OpenAI endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key-here
